{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/projeto/:slug",
      "destination": "/api/projeto?slug=:slug"
    },
    {
      "source": "/((?!assets/|api/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(favicon.ico|favicon-32x32.png|apple-touch-icon.png|icon-192.png|icon-512.png|phone-frame.png|site.webmanifest|og-image.jpg|alexandre-badge.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
